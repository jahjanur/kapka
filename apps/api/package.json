{
  "name": "@kapka/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "migrate:up": "node-pg-migrate up --envPath .env -m migrations",
    "migrate:deploy": "node-pg-migrate up -m migrations --no-check-order",
    "migrate:down": "node-pg-migrate down --envPath .env -m migrations",
    "migrate:create": "node-pg-migrate create --envPath .env -m migrations -j sql",
    "migrate:status": "node-pg-migrate up --envPath .env -m migrations --dry-run",
    "seed": "tsx src/seed/run.ts",
    "expire-requests": "tsx src/jobs/expireRequests.ts",
    "email:preview": "tsx scripts/email-preview.ts"
  },
  "dependencies": {
    "@kapka/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^9.1.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
