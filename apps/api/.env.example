# Copy to .env and fill in. .env is gitignored — a committed one means
# rotating every key (§12).
NODE_ENV=development
PORT=4000

# Comma-separated allow-list. No wildcards in production.
CORS_ORIGINS=http://localhost:5173

# Postgres — not used yet, listed so the shape is agreed up front.
DATABASE_URL=postgresql://kapka:kapka@localhost:5432/kapka

# Auth. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# SendGrid. Leave empty locally — Mailpit catches mail instead (§2).
SENDGRID_API_KEY=
SENDGRID_FROM=no-reply@kapka.mk
