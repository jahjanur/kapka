# Kapka API configuration.
#
# Copy to .env and adjust. .env is gitignored, and has been since the first
# commit — a committed one means rotating every key in it (§12).
#
# Every value below has a working default matching compose.yaml, so an empty
# .env is fine for local development. Variables marked REQUIRED IN PRODUCTION
# have no safe default and the API refuses to start without them.
#
# The API validates all of this at boot and fails loudly on anything wrong,
# rather than discovering it at the first login.

# ── Runtime ──────────────────────────────────────────────────────────────

# development | test | production. Gates the mail guard, the secret guard,
# cookie Secure flags and rate limiting.
# Default: development
NODE_ENV=development

# Port the API listens on.
# Default: 4000
PORT=4000

# Comma-separated allow-list of browser origins. No wildcards in production.
# Default: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────

# Postgres connection string. The default matches compose.yaml.
# Default: postgresql://kapka:kapka@localhost:5432/kapka
DATABASE_URL=postgresql://kapka:kapka@localhost:5432/kapka

# ── Auth ─────────────────────────────────────────────────────────────────

# Signs access tokens. REQUIRED IN PRODUCTION — at least 32 characters, or the
# API refuses to start rather than defaulting to something guessable. Locally
# it falls back to an obviously fake development key.
#   openssl rand -base64 48
# Default: a development-only key, outside production
JWT_ACCESS_SECRET=

# There is deliberately no JWT_REFRESH_SECRET. Refresh tokens are opaque
# random bytes stored as a SHA-256 hash, not JWTs — a signed refresh token
# stays valid until it expires whatever the server thinks, which is the
# property rotation needs it not to have.

# ── Mail ─────────────────────────────────────────────────────────────────

# smtp | sendgrid. 'smtp' delivers to Mailpit, the local catcher — read it at
# http://localhost:8025 and nothing leaves your machine. 'sendgrid' is the only
# setting that can reach a real inbox, and the API refuses to start with it
# outside production.
# Default: smtp
MAIL_TRANSPORT=smtp

# Mailpit's SMTP host, from compose.yaml.
# Default: localhost
SMTP_HOST=localhost

# Mailpit's SMTP port, from compose.yaml.
# Default: 1025
SMTP_PORT=1025

# The From address on every notification.
# Default: no-reply@kapka.mk
MAIL_FROM=no-reply@kapka.mk

# REQUIRED IN PRODUCTION when MAIL_TRANSPORT=sendgrid. Leave empty everywhere
# else: the API refuses to start if this is set at all outside production,
# because the realistic accident is a production .env copied onto a laptop.
# Default: empty
SENDGRID_API_KEY=
