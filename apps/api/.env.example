# Copy to .env and adjust. .env is gitignored — a committed one means
# rotating every key (§12).
#
# Every value below has a working default that matches compose.yaml, so an
# empty .env is fine for local development.

NODE_ENV=development
PORT=4000

# Comma-separated allow-list. No wildcards in production.
CORS_ORIGINS=http://localhost:5173

# Postgres from compose.yaml.
DATABASE_URL=postgresql://kapka:kapka@localhost:5432/kapka

# ── Mail ────────────────────────────────────────────────────────────────
# 'smtp' delivers to Mailpit, the local catcher — read it at
# http://localhost:8025. Nothing leaves your machine.
#
# 'sendgrid' is the only setting that can reach a real inbox, and the API
# refuses to start with it (or with any SENDGRID_API_KEY at all) unless
# NODE_ENV=production. Leave the key empty here.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@kapka.mk
SENDGRID_API_KEY=

# Auth. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
