# Copy to .env.local for local overrides. Both are gitignored.
#
# ⚠️  EVERY VARIABLE HERE IS PUBLIC.
#
# Vite inlines anything prefixed VITE_ into the JavaScript bundle it serves to
# browsers. It is not hidden, not encrypted, and viewable with "View Source".
# A secret put here is a secret published.
#
# Secrets belong in apps/api/.env, which is read by the server and never
# shipped anywhere. If the browser needs something a secret protects, the
# answer is an API endpoint, not a variable.

# Where the API lives. Empty means same-origin, which is what the production
# deploy uses.
VITE_API_URL=http://localhost:4000
