{
  "name": "kapka",
  "private": true,
  "version": "0.0.0",
  "description": "Urgent blood donation matching",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @kapka/web",
    "dev:api": "npm run dev --workspace @kapka/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
