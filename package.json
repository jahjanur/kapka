{
  "name": "kapka",
  "private": true,
  "version": "0.0.0",
  "description": "Urgent blood donation matching",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @kapka/web",
    "dev:api": "npm run dev --workspace @kapka/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:logs": "docker compose logs -f",
    "db:psql": "docker compose exec postgres psql -U kapka -d kapka",
    "mail": "open http://localhost:8025 || xdg-open http://localhost:8025",
    "migrate": "npm run migrate:up --workspace @kapka/api",
    "migrate:down": "npm run migrate:down --workspace @kapka/api",
    "migrate:create": "npm run migrate:create --workspace @kapka/api --",
    "migrate:status": "npm run migrate:status --workspace @kapka/api",
    "seed": "npm run seed --workspace @kapka/api",
    "expire-requests": "npm run expire-requests --workspace @kapka/api",
    "perf:budget": "npm run perf:budget --workspace @kapka/web",
    "perf:lighthouse": "lhci autorun --config=lighthouserc.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "type": "module",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{js,css,json,md,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
