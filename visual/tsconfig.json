{
  /* The visual suite drives the built product from outside, like e2e/, and is
     not an npm workspace — but it is TypeScript, so it gets the same
     strictness and the same type-aware linting. Without this file ESLint's
     project service has no project for it and refuses to parse it. */
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [".", "../playwright.visual.config.ts"]
}
